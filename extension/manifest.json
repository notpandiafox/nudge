{
  "manifest_version": 3,
  "name": "nudge",
  "version": "0.1.0",
  "description": "Hints for NYT Wordle, only when you ask.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nudge@notpandiafox",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/nudge.svg", "96": "icons/nudge.svg" },
  "action": {
    "default_title": "nudge",
    "default_icon": "icons/nudge.svg",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nytimes.com/games/wordle/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["https://www.nytimes.com/games/wordle/*"],
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
