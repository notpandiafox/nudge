{
  "name": "nudge-extension",
  "version": "0.1.0",
  "private": true,
  "description": "nudge: hints for NYT Wordle, only when you ask (Firefox extension).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "web-ext run --source-dir dist",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "webext:lint": "web-ext lint --source-dir dist",
    "package": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node extension/scripts/pre-commit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/firefox-webext-browser": "143.0.1",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.4",
    "web-ext": "10.7.0"
  }
}
